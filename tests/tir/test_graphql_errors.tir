"""
TIR Test — GraphQL Error Handling
Testa respostas de erro do endpoint GraphQL
"""
from pytest import mark
from contrib.tir import Webapp
import json
import urllib.parse


class TestGraphQLErrors:
    def setup_class(self):
        self.soapClient = Webapp("totvs.rest")
        self.soapClient.logon()

    def teardown_class(self):
        self.soapClient.close()

    def test_query_field_not_found(self):
        """Testa query com campo inexistente — deve retornar erro de validacao"""
        query = json.dumps({
            "query": "{ findCliente(codigo: \"000001\") { codigo nome campoInexistente } }"
        })
        encoded = urllib.parse.quote_plus(query)
        result = self.soapClient.http_get("/graphql?query=" + encoded)
        data = json.loads(result.text)

        assert "data" in data
        assert "errors" in data
        assert len(data["errors"]) > 0
        error_messages = [err.get("message", "") for err in data["errors"]]
        assert any("campoInexistente" in msg for msg in error_messages)

    def test_query_invalid_syntax(self):
        """Testa query com sintaxe invalida — deve retornar erro de parsing"""
        query = json.dumps({
            "query": "{ findCliente(codigo: \"000001\" { codigo }"
        })
        encoded = urllib.parse.quote_plus(query)
        result = self.soapClient.http_get("/graphql?query=" + encoded)
        data = json.loads(result.text)

        assert "errors" in data
        assert len(data["errors"]) > 0
        error_messages = [err.get("message", "") for err in data["errors"]]
        assert any("error" in msg.lower() or "parse" in msg.lower() for msg in error_messages)

    def test_query_empty(self):
        """Testa query vazia sem parametros — deve retornar introspeccao"""
        result = self.soapClient.http_get("/graphql?query=")
        data = json.loads(result.text)

        assert "data" in data
        assert "__schema" in data["data"]
