"""
TIR Test — GraphQL mutation denylist enforcement
"""
from contrib.tir import Webapp
import json
import urllib.parse


class TestGraphQLMutationDenylist:
    def setup_class(self):
        self.client = Webapp("totvs.rest")
        self.client.logon()

    def teardown_class(self):
        self.client.close()

    def test_mutation_denylist(self):
        gql = 'mutation { createSB1(input: {B1_COD: "ZZ0001"}) { B1_COD } }'
        result = self.client.http_get("/graphql?query=" + urllib.parse.quote_plus(gql))
        data = json.loads(result.text)
        assert "errors" in data
        assert "Unknown or restricted mutation" in data["errors"][0]["message"]
