"""
Teste TIR — mutation de criação GraphQL
"""
from contrib.tir import Webapp
import json
import urllib.parse


class TestGraphQLMutationCreate:
    def setup_class(self):
        self.client = Webapp("totvs.rest")
        self.client.logon()

    def teardown_class(self):
        self.client.close()

    def test_mutation_create(self):
        gql = 'mutation { createSA1(input: {A1_COD: "ZZ0001", A1_LOJA: "01", A1_NOME: "Mutation Test"}) { A1_COD A1_NOME } }'
        result = self.client.http_get("/graphql?query=" + urllib.parse.quote_plus(gql))
        data = json.loads(result.text)
        assert data["data"]["createSA1"]["A1_COD"] == "ZZ0001"
        assert data["data"]["createSA1"]["A1_NOME"] == "Mutation Test"

        # Verifica a criação via consulta de leitura
        verify_gql = '{ SA1(filter: [{field: "A1_COD", op: "eq", value: "ZZ0001"}]) { A1_COD A1_NOME } }'
        verify_result = self.client.http_get("/graphql?query=" + urllib.parse.quote_plus(verify_gql))
        verify_data = json.loads(verify_result.text)
        assert len(verify_data["data"]["SA1"]) == 1
        assert verify_data["data"]["SA1"][0]["A1_NOME"] == "Mutation Test"
