#include "tlpp-core.th"
#include "totvs.ch"
#include "gqltypes.tlpp"
#include "gqlschema.tlpp"
#include "gqlparser.tlpp"
#include "gqlvalidator.tlpp"
#include "gqlexecutor.tlpp"

namespace custom.graphql

// --------------------------------------------------------------------------
// GqlExecutive - main orchestration class for GraphQL queries
// --------------------------------------------------------------------------
/*/{Protheus.doc}
@type Object
@author GraphQL Engine Team
@since 1.0.0
/@*/
class GqlExecutive
    private data oSchema       as object
    private data oParser       as object
    private data oExecutor     as object
    private data aRegistered   as array
    private data cDefaultFilial as character

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Object - self
    /@*/
    method new() as object class GqlExecutive
        ::oSchema        := GqlSchema():new("Auto-generated GraphQL Schema")
        ::oParser        := GqlParser():new()
        ::oExecutor      := GqlExecutor():new(::oSchema)
        ::aRegistered    := {}
        ::cDefaultFilial := ""
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cFilial Character - default branch for queries
    @return Object - self for chaining
    /@*/
    method setDefaultFilial(cFilial as character) as object class GqlExecutive
        ::cDefaultFilial := cFilial
        FWLogMsg("GqlExecutive: default filial set to '" + cFilial + "'", .T.)
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cTable Character - Protheus table alias (e.g., SA1)
    @param cTypeName Character - GraphQL type name (e.g., Cliente)
    @param aFields Array - Protheus field names (e.g., {"A1_COD","A1_NOME"})
    @return Object - self for chaining
    /@*/
    method registerModule(cTable as character, cTypeName as character, aFields as array) as object class GqlExecutive
        local oType         := nil as object
        local nI            := 0 as numeric
        local cProtheus     := "" as character
        local cGraphQL      := "" as character
        local oField        := nil as object
        local bResolver     := nil as codeblock
        local cListName     := "" as character
        local cFindName     := "" as character
        local oListField    := nil as object
        local oFindField    := nil as object
        local cFirstField   := "" as character
        local cGraphQLFirst := "" as character
        local bListResolver := nil as codeblock
        local bFindResolver := nil as codeblock
        local oScalarType   := nil as object

        oType := GqlObjectType():new(cTypeName, cTable, "Module: " + cTable)

        for nI := 1 step 1 while nI <= len(aFields)
            cProtheus   := aFields[nI]
            cGraphQL    := GqlExecutive:toCamelCase(cProtheus)
            oScalarType := GqlScalarType():new("String", "C", "Field " + cGraphQL)
            bResolver   := {|oParent, oArgs, oSch, cFil| JsonGet(oParent, cGraphQL)}
            oField      := GqlField():new(cGraphQL, oScalarType, bResolver, "Field " + cGraphQL)
            oType:addField(oField)
            FWLogMsg("GqlExecutive: registered field '" + cGraphQL + "' on type '" + cTypeName + "'", .T.)
        next nI

        ::oSchema:registerType(oType)

        cFirstField   := aFields[1]
        cGraphQLFirst := GqlExecutive:toCamelCase(cFirstField)

        cListName := "list" + cTypeName
        bListResolver := {|oParent, oArgs, oSch, cFil| ::resolveList(cTable, aFields, cGraphQLFirst, oArgs, cFil)}
        oListField := GqlField():new(cListName, oType, bListResolver, "List " + cTypeName)
        oListField:addArg("primeiro", GqlScalarType():new("Int", "N", "Limit"), nil)
        oListField:addArg("offset", GqlScalarType():new("Int", "N", "Offset"), nil)
        ::oSchema:getQueryType():addField(oListField)

        cFindName := "find" + cTypeName
        bFindResolver := {|oParent, oArgs, oSch, cFil| ::resolveFind(cTable, aFields, cGraphQLFirst, oArgs, cFil)}
        oFindField := GqlField():new(cFindName, oType, bFindResolver, "Find " + cTypeName)
        oFindField:addArg(cGraphQLFirst, GqlScalarType():new("String", "C", "Primary key"), nil)
        ::oSchema:getQueryType():addField(oFindField)

        aAdd(::aRegistered, cTable)
        FWLogMsg("GqlExecutive: registered module '" + cTable + "' as type '" + cTypeName + "'", .T.)

        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cQuery Character - GraphQL query string
    @param cFilial Character - branch override (uses default if empty)
    @return JSON - execution result
    /@*/
    method executeQuery(cQuery as character, cFilial as character) as json class GqlExecutive
        local oDoc     := nil as json
        local oResult  := nil as json
        local cUsedFil := "" as character
        local aParseErr := nil as array

        oDoc := ::oParser:parse(cQuery)

        if oDoc == nil
            oResult := JsonParse("{}")
            JsonSet(oResult, "errors", {{"message": "Parse error: document is nil", "extensions": {{"code": "PARSE_ERROR"}}}})
            return oResult
        endif

        aParseErr := JsonGet(oDoc, "errors")
        if aParseErr != nil .and. len(aParseErr) > 0
            oResult := JsonParse("{}")
            JsonSet(oResult, "errors", aParseErr)
            return oResult
        endif

        if cFilial == "" .or. cFilial == nil
            cUsedFil := ::cDefaultFilial
        else
            cUsedFil := cFilial
        endif

        ::oExecutor:setFilial(cUsedFil)
        oResult := ::oExecutor:execute(oDoc)

        return oResult
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return JSON - introspection result
    /@*/
    method introspect() as json class GqlExecutive
        return ::oSchema:buildIntrospection()
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Array - registered modules array
    /@*/
    method getRegisteredModules() as array class GqlExecutive
        return ::aRegistered
    endmethod

    // -- Internal resolvers --

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @desc Resolves a list query with pagination
    /@*/
    static method resolveList(cTable as character, aFields as array, cFirstGraphQL as character, oArgs as json, cFilial as character) as array class GqlExecutive
        local aResult     := {} as array
        local cSql        := "" as character
        local nPrimeiro   := 0 as numeric
        local nOffset     := 0 as numeric
        local oRs         := nil as object
        local nCount      := 0 as numeric
        local nI          := 0 as numeric
        local oRow        := nil as object
        local oJson       := nil as json
        local nJ          := 0 as numeric
        local cProtheus   := "" as character
        local cGraphQL    := "" as character
        local cLimit      := "" as character
        local cOffsetVal  := "" as character

        nPrimeiro := 10
        nOffset   := 0

        if oArgs != nil
            nPrimeiro := JsonGet(oArgs, "primeiro")
            nOffset   := JsonGet(oArgs, "offset")
            if nPrimeiro == nil .or. nPrimeiro < 0
                nPrimeiro := 10
            endif
            if nOffset == nil .or. nOffset < 0
                nOffset := 0
            endif
        endif

        cSql := "SELECT " + ::joinFields(aFields) + " FROM " + RetSqlName(cTable) + " WHERE D_E_L_E_T_ = ' ' ORDER BY " + cFirstField

        if nPrimeiro > 0
            cLimit  := " TOP " + cValToChar(nPrimeiro)
            cOffsetVal := " SKIP " + cValToChar(nOffset)
            cSql := cSql + cLimit + cOffsetVal
        endif

        oRs := FWExecStatement(cSql)

        if oRs != nil
            nCount := oRs:RowCount()
            for nI := 1 step 1 while nI <= nCount
                oRow   := oRs:GetStruct()
                oJson  := JsonParse("{}")
                for nJ := 1 step 1 while nJ <= len(aFields)
                    cProtheus := aFields[nJ]
                    cGraphQL  := ::toCamelCaseInternal(cProtheus)
                    JsonSet(oJson, cGraphQL, oRow:cField(cProtheus))
                next nJ
                aAdd(aResult, oJson)
            next nI
            oRs:Close()
        else
            FWLogMsg("GqlExecutive: resolveList failed for table " + cTable, .F.)
        endif

        return aResult
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @desc Resolves a find query by primary key
    /@*/
    static method resolveFind(cTable as character, aFields as array, cFirstGraphQL as character, oArgs as json, cFilial as character) as json class GqlExecutive
        local oResult := nil as json
        local cSql    := "" as character
        local oRs     := nil as object
        local oJson   := nil as json
        local nJ      := 0 as numeric
        local cProtheus := "" as character
        local cGraphQL  := "" as character
        local cKeyValue := "" as character

        if oArgs == nil
            return nil
        endif

        cKeyValue := JsonGet(oArgs, cFirstGraphQL)
        if cKeyValue == nil .or. cKeyValue == ""
            return nil
        endif

        cSql := "SELECT " + ::joinFields(aFields) + " FROM " + RetSqlName(cTable) + " WHERE D_E_L_E_T_ = ' ' AND " + aFields[1] + " = '" + cKeyValue + "'"

        oRs := FWExecStatement(cSql)

        if oRs != nil .and. oRs:RowCount() > 0
            oJson := JsonParse("{}")
            oRs:GetStruct()
            for nJ := 1 step 1 while nJ <= len(aFields)
                cProtheus := aFields[nJ]
                cGraphQL  := ::toCamelCaseInternal(cProtheus)
                JsonSet(oJson, cGraphQL, oRs:cField(cProtheus))
            next nJ
            oRs:Close()
        else
            oResult := nil
        endif

        return oJson
    endmethod

    // -- Static helpers --

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param aFields Array - field name array
    @return Character - comma-joined field names
    /@*/
    static method joinFields(aFields as array) as character class GqlExecutive
        local cResult := "" as character
        local nI      := 0 as numeric

        for nI := 1 step 1 while nI <= len(aFields)
            if nI > 1
                cResult += ", "
            endif
            cResult += aFields[nI]
        next nI

        return cResult
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cField Character - Protheus field name (e.g., A1_COD)
    @return Character - camelCase version (e.g., a1Cod)
    /@*/
    static method toCamelCase(cField as character) as character class GqlExecutive
        return ::toCamelCaseInternal(cField)
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @desc Internal camelCase converter — removes underscores, lowercases first char, capitalizes chars after underscores
    /@*/
    static method toCamelCaseInternal(cField as character) as character class GqlExecutive
        local cResult   := "" as character
        local nI        := 0 as numeric
        local cCh       := "" as character
        local lNextUpper := .F. as logical

        if empty(cField)
            return cField
        endif

        for nI := 1 step 1 while nI <= len(cField)
            cCh := substr(cField, nI, 1)
            if cCh == "_"
                lNextUpper := .T.
            else
                if lNextUpper
                    cResult += upper(cCh)
                    lNextUpper := .F.
                elseif nI == 1
                    cResult += lower(cCh)
                else
                    cResult += cCh
                endif
            endif
        next nI

        return cResult
    endmethod

endclass

endnamespace
