#include "tlpp-core.th"
#include "totvs.ch"
#include "gqltypes.tlpp"
#include "gqlschema.tlpp"

namespace custom.graphql

// --------------------------------------------------------------------------
// initSA1Schema — entry point to register SA1 (clientes) types on a schema
// --------------------------------------------------------------------------
/*/{Protheus.doc}
@author GraphQL Engine Team
@since 1.0.0
@param oSchema Object - GqlSchema to initialize with SA1 types
@return Object - self for chaining
/@*/
function initSA1Schema(oSchema as object) as object
    buildClientType(oSchema)
    buildClientQueryFields(oSchema)
    return self
endfunction

endnamespace
