#include "tlpp-core.th"
#include "totvs.ch"
#include "gqltypes.tlpp"
#include "gqlschema.tlpp"

namespace custom.graphql

// --------------------------------------------------------------------------
// initSC5Schema - entry point to register SC5 (notas fiscais) types on a schema
// --------------------------------------------------------------------------
/*/{Protheus.doc}
@author GraphQL Engine Team
@since 1.0.0
@param oSchema Object - GqlSchema to initialize with SC5 types
@return Object - self for chaining
@type Function
/*/
function initSC5Schema(oSchema as object) as object
    FWLogMsg("initSC5Schema: starting SC5 schema registration", .T.)
    buildInvoiceType(oSchema)
    buildInvoiceQueryFields(oSchema)
    FWLogMsg("initSC5Schema: SC5 schema registered successfully", .T.)
    return oSchema
endfunction

endnamespace
