#include "tlpp-core.th"
#include "totvs.ch"

namespace custom.backoffice.graphql

/*/{Protheus.doc}
@type Objeto
@author GraphQL Engine Team
@since 3.1.0
@desc GqlMutationExecutor - parseia um documento mutation, resolve cada
      campo raiz para tabela+operação (createTABLE/updateTABLE/deleteTABLE),
      valida e escreve via GqlInputValidator/GqlWorkareaWriter (workarea
      nativa RecLock/FieldPut/MsUnlock, nunca SQL), e retorna a linha
      afetada via o executor de leitura existente.
/@*/
class GqlMutationExecutor
    private data oMutationSchema   as object
    private data oDictionaryReader as object
    private data oInputValidator   as object
    private data oWorkareaWriter   as object
    private data oExecutor         as object
    private data oAccessControl    as object

    public method new(oMutationSchema as object, oDictionaryReader as object, oInputValidator as object, oWorkareaWriter as object, oExecutor as object, oAccessControl as object) as object
    public method execute(cQuerySource as character) as json
method resolveMutationField(oField as json) as json
    method splitFieldName(cName as character) as json
    method keyFieldNames(cTable as character) as array
    method nonKeyPresentFields(cTable as character, oInput as json, aKeyFields as array, cFilialField as character) as array
    method fetchByKey(cTable as character, oField as json, oInput as json, aKeyFields as array, cFilialField as character) as array
endclass

method new(oMutationSchema as object, oDictionaryReader as object, oInputValidator as object, oWorkareaWriter as object, oExecutor as object, oAccessControl as object) as object class GqlMutationExecutor
    ::oMutationSchema   := oMutationSchema
    ::oDictionaryReader := oDictionaryReader
    ::oInputValidator   := oInputValidator
    ::oWorkareaWriter   := oWorkareaWriter
    ::oExecutor         := oExecutor
    ::oAccessControl    := oAccessControl
    return self

/*/{Protheus.doc}
@type Method
@author GraphQL Engine Team
@since 3.1.0
@param cQuerySource Character - raw GraphQL mutation text
@return JSON - {"data": {...}} on success, {"errors": [...]} on failure
/@*/
method execute(cQuerySource as character) as json class GqlMutationExecutor
    local oParser := GqlParser():new(cQuerySource) as object
    local oDoc    as json
    local aDefs   as array
    local aSel    as array
    local oData   as json
    local nI      := 0 as numeric
    local nJ      := 0 as numeric
    local oFieldResult as json
    local oResult as json

    oDoc := oParser:parse()
    if oDoc == nil
        return GqlErrors():fromArray(oParser:getErrors())
    endif

    oData := JsonObject():New()
    aDefs := oDoc["definitions"]
    for nI := 1 to len(aDefs)
        aSel := aDefs[nI]["selectionSet"]
        for nJ := 1 to len(aSel)
            oFieldResult := ::resolveMutationField(aSel[nJ])
            if oFieldResult["errors"] != nil
                return oFieldResult
            endif
            oData[oFieldResult["alias"]] := oFieldResult["row"]
        next nJ
    next nI

    oResult := JsonObject():New()
    oResult["data"] := oData
    return oResult

/*/{Protheus.doc}
@type Method
@author GraphQL Engine Team
@since 3.1.0
@param oField JSON - root Field AST node, e.g. createSA1(input: {...})
@return JSON - either {"errors": [...]} (whole-request error, caller
        returns it directly) or {"alias": <character>, "row": <json-or-nil>}
        on success
/@*/
method resolveMutationField(oField as json) as json class GqlMutationExecutor
    local oParsed   := ::splitFieldName(oField["name"]) as json
    local cOp       as character
    local cTable    as character
    local oInputArg as json
    local oInput    as json
    local aErrors   := {} as array
    local aKeyFields as array
    local aSetFields as array
    local aFields   as array
    local aFieldNames as array
    local aInputNames as array
    local nI        := 0 as numeric
    local nK        := 0 as numeric
    local cKeyName  := "" as character
    local cFilialField as character
    local aExisting as array
    local aRows     as array
    local oOut      as json
    local cAlias    := "" as character

    if oParsed == nil
        return GqlErrors():single("Unknown or restricted mutation: " + oField["name"])
    endif
    cOp    := oParsed["op"]
    cTable := oParsed["table"]

    if !::oMutationSchema:isMutable(cTable)
        return GqlErrors():single("Unknown or restricted mutation: " + oField["name"])
    endif

    if !::oAccessControl:isUserAllowed(cTable, "write")
        return GqlErrors():single("Unknown or restricted mutation: " + oField["name"])
    endif

    oInputArg := oField["arguments"]["input"]
    if oInputArg == nil .or. oInputArg["value"] == nil
        return GqlErrors():single("Mutation '" + oField["name"] + "' requires an 'input' argument")
    endif
    if oInputArg["kind"] != "ObjectValue"
        return GqlErrors():single("Mutation '" + oField["name"] + "' argument 'input' must be an object")
    endif
    oInput := oInputArg["value"]

    aInputNames := oInput:GetNames()
    for nK := 1 to len(aInputNames)
        cKeyName := aInputNames[nK]
        oInput[cKeyName] := oInput[cKeyName]["value"]
    next nK

    cAlias := oField["name"]
    if oField["alias"] != nil
        cAlias := oField["alias"]
    endif

    aKeyFields := ::keyFieldNames(cTable)
    cFilialField := ::oDictionaryReader:getFilialField(cTable)

    if cOp == "create"
        aErrors := ::oInputValidator:validateCreate(cTable, oInput)
        if len(aErrors) > 0
            return GqlErrors():fromArray(aErrors)
        endif
        aFields := ::oDictionaryReader:getTableFields(cTable)
        aFieldNames := {}
        for nI := 1 to len(aFields)
            if oInput[aFields[nI]["name"]] != nil
                aAdd(aFieldNames, aFields[nI]["name"])
            endif
        next nI
        if !::oWorkareaWriter:writeCreate(cTable, cFilialField, oInput, aFieldNames, aKeyFields)
            return GqlErrors():single("Write failed for '" + oField["name"] + "'")
        endif
        aRows := ::fetchByKey(cTable, oField, oInput, aKeyFields, cFilialField)
        oOut := JsonObject():New()
        oOut["alias"] := cAlias
        if len(aRows) > 0
            oOut["row"] := aRows[1]
        else
            oOut["row"] := nil
        endif
        return oOut

    elseif cOp == "update"
        for nI := 1 to len(aKeyFields)
            if oInput[aKeyFields[nI]] == nil
                return GqlErrors():single("Missing key field '" + aKeyFields[nI] + "' for update")
            endif
        next nI
        aExisting := ::fetchByKey(cTable, oField, oInput, aKeyFields, cFilialField)
        if len(aExisting) == 0
            return GqlErrors():single("Row not found for update")
        endif
        aErrors := ::oInputValidator:validateUpdate(cTable, oInput)
        if len(aErrors) > 0
            return GqlErrors():fromArray(aErrors)
        endif
        aSetFields := ::nonKeyPresentFields(cTable, oInput, aKeyFields, cFilialField)
        if len(aSetFields) == 0
            return GqlErrors():single("Update requires at least one non-key field")
        endif
        if !::oWorkareaWriter:writeUpdate(cTable, cFilialField, oInput, aKeyFields, aSetFields)
            return GqlErrors():single("Write failed for '" + oField["name"] + "'")
        endif
        aRows := ::fetchByKey(cTable, oField, oInput, aKeyFields, cFilialField)
        oOut := JsonObject():New()
        oOut["alias"] := cAlias
        if len(aRows) > 0
            oOut["row"] := aRows[1]
        else
            oOut["row"] := nil
        endif
        return oOut

    elseif cOp == "delete"
        for nI := 1 to len(aKeyFields)
            if oInput[aKeyFields[nI]] == nil
                return GqlErrors():single("Missing key field '" + aKeyFields[nI] + "' for delete")
            endif
        next nI
        aExisting := ::fetchByKey(cTable, oField, oInput, aKeyFields, cFilialField)
        if len(aExisting) == 0
            return GqlErrors():single("Row not found for delete")
        endif
        if !::oWorkareaWriter:writeSoftDelete(cTable, cFilialField, oInput, aKeyFields)
            return GqlErrors():single("Write failed for '" + oField["name"] + "'")
        endif
        oOut := JsonObject():New()
        oOut["alias"] := cAlias
        oOut["row"] := aExisting[1]
        return oOut
    endif

    return GqlErrors():single("Unknown or restricted mutation: " + oField["name"])

/*/{Protheus.doc}
@type Method
@author GraphQL Engine Team
@since 3.1.0
@param cName Character - root field name, e.g. "createSA1"
@return JSON - {"op": "create"|"update"|"delete", "table": <character>},
        or nil if cName doesn't start with a known mutation prefix
/@*/
method splitFieldName(cName as character) as json class GqlMutationExecutor
    local oOut as json

    oOut := JsonObject():New()
    if left(cName, 6) == "create"
        oOut["op"] := "create"
        oOut["table"] := substr(cName, 7)
        return oOut
    elseif left(cName, 6) == "update"
        oOut["op"] := "update"
        oOut["table"] := substr(cName, 7)
        return oOut
    elseif left(cName, 6) == "delete"
        oOut["op"] := "delete"
        oOut["table"] := substr(cName, 7)
        return oOut
    endif

    return nil

method keyFieldNames(cTable as character) as array class GqlMutationExecutor
    local cKey := ::oDictionaryReader:getOrderKey(cTable) as character
    local aResult := {} as array
    local nStart := 1 as numeric
    local nSep := 0 as numeric

    // "+" é o separador real de chave SIX do Protheus (ex.
    // "A1_FILIAL+A1_COD+A1_LOJA", confirmado diretamente contra six990) - o
    // fallback escalar de campo único de getOrderKey() nunca contém "+", então
    // este parsing é correto para ambos os casos.
    nSep := at("+", cKey)
    while nSep > 0
        aAdd(aResult, alltrim(substr(cKey, nStart, nSep - nStart)))
        nStart := nSep + 1
        nSep := at("+", cKey, nStart)
    enddo
    if nStart <= len(cKey)
        aAdd(aResult, alltrim(substr(cKey, nStart)))
    endif

    return aResult

/*/{Protheus.doc}
@type Method
@author GraphQL Engine Team
@since 3.1.0
@param cTable Character - table alias
@param oInput JSON - parsed mutation input object (flat field map)
@param aKeyFields Array - the table's order-key field names (excluded from SET)
@param cFilialField Character - the table's own filial field name (also
       excluded from SET, unconditionally, regardless of whether it is part
of aKeyFields - the filial value is always forced from cFilAnt by
        GqlWorkareaWriter, never taken from client input, so it must never
       reach the SET-field list either).
@return Array - field names present in oInput, excluding key fields and the
        filial field, eligible for the UPDATE's SET clause.
/@*/
method nonKeyPresentFields(cTable as character, oInput as json, aKeyFields as array, cFilialField as character) as array class GqlMutationExecutor
    local aFields := ::oDictionaryReader:getTableFields(cTable) as array
    local aResult := {} as array
    local nI      := 0 as numeric
    local cName   := "" as character

    for nI := 1 to len(aFields)
        cName := aFields[nI]["name"]
        if ascan(aKeyFields, {|c| c == cName}) > 0
            loop
        endif
        if !empty(cFilialField) .and. cName == cFilialField
            loop
        endif
        if oInput[cName] != nil
            aAdd(aResult, cName)
        endif
    next nI

    return aResult

/*/{Protheus.doc}
@type Method
@author GraphQL Engine Team
@since 3.1.0
@desc Re-selects a single row by key fields, shaped by oField's own
      selectionSet, using the existing read-path executor
      (GqlExecutor:resolveTableField) - never duplicates row-fetch logic.
/@*/
method fetchByKey(cTable as character, oField as json, oInput as json, aKeyFields as array, cFilialField as character) as array class GqlMutationExecutor
    local cWhere := "" as character
    local nI     := 0 as numeric
    local oSynthField as json
    local cKeyValue as character
    local aParams := {} as array
    local oP     as json

    for nI := 1 to len(aKeyFields)
        if nI > 1
            cWhere += " AND "
        endif
        // O campo de filial da chave nunca é lido do oInput - mutations
        // de create não são obrigadas a fornecê-lo (é sempre forçado de
        // cFilAnt, exatamente como o GqlWorkareaWriter faz nas cláusulas
        // WHERE de INSERT/UPDATE/DELETE). Update/delete exigem-no no oInput
        // (validado pelo chamador), mas forçar cFilAnt aqui mantém a
        // garantia de mesma filial consistente para toda operação.
        if !empty(cFilialField) .and. aKeyFields[nI] == cFilialField
            cKeyValue := cFilAnt
        else
            cKeyValue := cValToChar(oInput[aKeyFields[nI]])
        endif
        cWhere += aKeyFields[nI] + " = ?"
        oP := JsonObject():New()
        oP["t"] := "C"
        oP["v"] := cKeyValue
        aAdd(aParams, oP)
    next nI

    // oField é o campo raiz da mutation (ex. "createSA1"/"updateSA1"/"deleteSA1"):
    // seu próprio nome NÃO é o nome da tabela, apenas seu selectionSet é
    // reutilizável aqui. GqlExecutor:resolveTableField deriva a tabela de
    // oField["name"], então um nó de campo sintético nomeando a tabela real
    // (cTable) precisa ser construído, reutilizando o selectionSet de oField
    // e um objeto de argumentos vazio (nenhum filter/limit/offset deve
    // vazar do próprio argumento "input" da mutation).
    oSynthField := JsonObject():New()
    oSynthField["name"] := cTable
    oSynthField["selectionSet"] := oField["selectionSet"]
    oSynthField["arguments"] := JsonObject():New()

    return ::oExecutor:resolveTableField(oSynthField, cWhere, aParams)

