#include "tlpp-core.th"
#include "totvs.ch"
#include "types.tlpp"
#include "schema.tlpp"

namespace custom.backoffice.graphql

// --------------------------------------------------------------------------
// GqlValidator - validates parsed GraphQL AST against the schema
// --------------------------------------------------------------------------
/*/{Protheus.doc}
@author GraphQL Engine Team
@since 1.0.0
@type Object
/@*/
class GqlValidator
    private data oSchema   as object   // GqlSchema reference
    private data aErrors   as array    // list of GqlError objects
    private data oVariables as json    // variable values (future use)

    // -- Constructor --

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param oSchema Object - GqlSchema to validate against
    @return Object - self
    /@*/
    method new(oSchema as object) as object class GqlValidator
        ::oSchema     := oSchema
        ::aErrors     := {}
        ::oVariables  := nil
        return self
    endmethod

    // -- Public API --

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param oVars JSON - variable values
    @return Object - self for chaining
    /@*/
    method setVariables(oVars as json) as object class GqlValidator
        ::oVariables := oVars
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param oDocument JSON - AST document from parser
    @return Array - array of GqlError objects
    /@*/
    method validate(oDocument as json) as array class GqlValidator
        local aDefs  := JsonGet(oDocument, "definitions")
        local nCount := len(aDefs)
        local nI     := 0 as numeric
        local oDef   := nil as object

        for nI := 1 step 1 while nI <= nCount
            oDef := aDefs[nI]
            ::validateDefinition(oDef)
        next nI

        return ::aErrors
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Array - current errors array
    /@*/
    method getErrors() as array class GqlValidator
        return ::aErrors
    endmethod

    // -- Internal validation --

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param oDef JSON - definition node from AST
    /@*/
    method validateDefinition(oDef as json) class GqlValidator
        local cKind     := JsonGet(oDef, "kind")
        local cOperation := JsonGet(oDef, "operation")
        local oSS       := JsonGet(oDef, "selectionSet")

        if cKind != "OperationDefinition"
            ::addError("Invalid definition: expected 'OperationDefinition', got '" + cKind + "'")
            return
        endIf

        if cOperation != "query" .and. cOperation != "mutation" .and. cOperation != "subscription"
            ::addError("Unsupported operation: '" + cOperation + "'. Expected 'query', 'mutation', or 'subscription'")
            return
        endIf

        if cOperation == "query" .or. cOperation == "subscription"
            ::validateSelectionSet(oSS, ::oSchema:getQueryType())
        elseif cOperation == "mutation"
            local nMutCount := len(::oSchema:getMutations())
            local nMutI     := 0 as numeric
            local oMutType  := nil as object
            local cFirst    := "" as character

            for nMutI := 1 step 1 while nMutI <= nMutCount
                oMutType := ::oSchema:getMutations()[nMutI]
                exit
            next nMutI

            if oMutType != nil
                ::validateSelectionSet(oSS, oMutType)
            else
                ::addError("Mutation operation found but no mutation type is registered in schema")
            endIf
        endIf
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param aSelections Array - selection set array from AST
    @param oParentType Object - parent GqlObjectType to validate fields against
    /@*/
    method validateSelectionSet(aSelections as array, oParentType as object) class GqlValidator
        local nCount  := len(aSelections)
        local nI      := 0 as numeric
        local oField  := nil as object
        local cName   := "" as character
        local oSS     := nil as object
        local oFieldObj := nil as object

        for nI := 1 step 1 while nI <= nCount
            oField := aSelections[nI]
            cName  := JsonGet(oField, "name")

            if cName == "__typename"
                // __typename is always valid, skip validation
                loop
            endIf

            oFieldObj := ::findField(oParentType, cName)
            if oFieldObj == nil
                ::addError("Unknown field '" + cName + "' on type '" + oParentType:getName() + "'")
                loop
            endIf

            oSS := JsonGet(oField, "selectionSet")
            if oSS != nil .and. len(oSS) > 0
                local oReturnType := oFieldObj:getReturnType()
                if oReturnType != nil .and. type(oReturnType) == "O"
                    ::validateSelectionSet(oSS, oReturnType)
                endIf
            endIf
        next nI
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param oType Object - GqlObjectType to search in
    @param cName Character - field name to look up
    @return Object - GqlField if found, nil otherwise
    /@*/
    method findField(oType as object, cName as character) as object class GqlValidator
        local aFields    := oType:getFields()
        local nCount     := len(aFields)
        local nI         := 0 as numeric
        local oField     := nil as object
        local aInterfaces := oType:getInterfaces()
        local nIntCount  := len(aInterfaces)
        local nIntI      := 0 as numeric
        local cIntName   := "" as character
        local oIntType   := nil as object
        local oIntField  := nil as object

        for nI := 1 step 1 while nI <= nCount
            oField := aFields[nI]
            if oField:getName() == cName
                return oField
            endIf
        next nI

        for nIntI := 1 step 1 while nIntI <= nIntCount
            cIntName := aInterfaces[nIntI]
            oIntType := ::oSchema:getType(cIntName)
            if oIntType != nil
                oIntField := ::findField(oIntType, cName)
                if oIntField != nil
                    return oIntField
                endIf
            endIf
        next nIntI

        return nil
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cMsg Character - error message
    /@*/
    method addError(cMsg as character) class GqlValidator
        local oErr := GqlError():new(cMsg, "ValidationError")
        aAdd(::aErrors, oErr)
    endmethod

endclass

endnamespace
