#include "tlpp-core.th"
#include "totvs.ch"

namespace custom.backoffice.graphql

// --------------------------------------------------------------------------
// GqlScalarType - represents scalar GraphQL types
// --------------------------------------------------------------------------
/*/{Protheus.doc}
@type Object
@author GraphQL Engine Team
@since 1.0.0
/@*/
class GqlScalarType
    private data cName       as character
    private data cProtheusType as character   // 'C', 'N', 'D', 'L'
    private data cDescription as character

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cName Character - Type name
    @param cProtheusType Character - Protheus type ('C','N','D','L')
    @param cDescription Character - Description
    @return Object - self
    /@*/
    method new(cName as character, cProtheusType as character, cDescription as character) as object class GqlScalarType
        ::cName        := cName
        ::cProtheusType := cProtheusType
        ::cDescription := cDescription
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Type name
    /@*/
    method getName()      as character class GqlScalarType
        return ::cName
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Protheus type ('C','N','D','L')
    /@*/
    method getProtheusType() as character class GqlScalarType
        return ::cProtheusType
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Description
    /@*/
    method getDescription() as character class GqlScalarType
        return ::cDescription
    endmethod
endclass

// --------------------------------------------------------------------------
// GqlField - represents a field on an object type
// --------------------------------------------------------------------------
/*/{Protheus.doc}
@type Object
@author GraphQL Engine Team
@since 1.0.0
/@*/
class GqlField
    private data cName        as character
    private data oReturnType  as object   // GqlScalarType or GqlObjectType
    private data bResolver    as codeblock
    private data cDescription as character
    private data aArgs        as array

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cName Character - Field name
    @param oReturnType Object - Return type
    @param bResolver CodeBlock - Resolver function
    @param cDescription Character - Description
    @return Object - self
    /@*/
    method new(cName as character, oReturnType as object, bResolver as codeblock, cDescription as character) as object class GqlField
        ::cName        := cName
        ::oReturnType  := oReturnType
        ::bResolver    := bResolver
        ::cDescription := cDescription
        ::aArgs        := {}
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Field name
    /@*/
    method getName()        as character class GqlField
        return ::cName
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Object - Return type
    /@*/
    method getReturnType()  as object class GqlField
        return ::oReturnType
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return CodeBlock - Resolver
    /@*/
    method getResolver()    as codeblock class GqlField
        return ::bResolver
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Description
    /@*/
    method getDescription() as character class GqlField
        return ::cDescription
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cName Character - Argument name
    @param oType Object - Argument type
    @param bValidate CodeBlock - Validation codeblock
    @return Object - self
    /@*/
    method addArg(cName as character, oType as object, bValidate as codeblock) as object class GqlField
        local aArg := {"name": cName, "type": oType, "validate": bValidate}
        aAdd(::aArgs, aArg)
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Array - Arguments array
    /@*/
    method getArgs() as array class GqlField
        return ::aArgs
    endmethod
endclass

// --------------------------------------------------------------------------
// GqlObjectType - represents a GraphQL object type (maps to a Protheus table)
// --------------------------------------------------------------------------
/*/{Protheus.doc}
@type Object
@author GraphQL Engine Team
@since 1.0.0
/@*/
class GqlObjectType
    private data cName       as character
    private data cTable      as character   // Protheus table alias (SA1, SB1, etc.)
    private data cDescription as character
    private data aFields     as array
    private data bFindById   as codeblock
    private data bFindList   as codeblock
    private data aImplements as array

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cName Character - Type name
    @param cTable Character - Protheus table alias
    @param cDescription Character - Description
    @return Object - self
    /@*/
    method new(cName as character, cTable as character, cDescription as character) as object class GqlObjectType
        ::cName        := cName
        ::cTable       := cTable
        ::cDescription := cDescription
        ::aFields      := {}
        ::aImplements  := {}
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Type name
    /@*/
    method getName()          as character class GqlObjectType
        return ::cName
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Protheus table alias
    /@*/
    method getTable()         as character class GqlObjectType
        return ::cTable
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Description
    /@*/
    method getDescription()   as character class GqlObjectType
        return ::cDescription
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param oField Object - Field to add
    @return Object - self
    /@*/
    method addField(oField as object) as object class GqlObjectType
        aAdd(::aFields, oField)
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Array - Fields array
    /@*/
    method getFields()        as array class GqlObjectType
        return ::aFields
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param bFn CodeBlock - FindById function
    @return Object - self
    /@*/
    method setFindById(bFn as codeblock) as object class GqlObjectType
        ::bFindById := bFn
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return CodeBlock - FindById function
    /@*/
    method getFindById()      as codeblock class GqlObjectType
        return ::bFindById
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param bFn CodeBlock - FindList function
    @return Object - self
    /@*/
    method setFindList(bFn as codeblock) as object class GqlObjectType
        ::bFindList := bFn
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return CodeBlock - FindList function
    /@*/
    method getFindList()      as codeblock class GqlObjectType
        return ::bFindList
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cInterface Character - Interface name
    @return Object - self
    /@*/
    method addInterface(cInterface as character) as object class GqlObjectType
        aAdd(::aImplements, cInterface)
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Array - Interfaces array
    /@*/
    method getInterfaces()    as array class GqlObjectType
        return ::aImplements
    endmethod
endclass

// --------------------------------------------------------------------------
// GqlQueryType - root query object
// --------------------------------------------------------------------------
/*/{Protheus.doc}
@type Object
@author GraphQL Engine Team
@since 1.0.0
/@*/
class GqlQueryType from GqlObjectType
    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Object - self
    /@*/
    method new() as object class GqlQueryType
        ::new("Query", "", "Root query type")
        return self
    endmethod
endclass

// --------------------------------------------------------------------------
// GqlError - represents a GraphQL error
// --------------------------------------------------------------------------
/*/{Protheus.doc}
@type Object
@author GraphQL Engine Team
@since 1.0.0
/@*/
class GqlError
    private data cMessage as character
    private data aPaths   as array
    private data cCode    as character

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cMessage Character - Error message
    @param cCode Character - Error code
    @return Object - self
    /@*/
    method new(cMessage as character, cCode as character) as object class GqlError
        ::cMessage := cMessage
        ::cCode    := cCode
        ::aPaths   := {}
        return self
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Error message
    /@*/
    method getMessage() as character class GqlError
        return ::cMessage
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Error code
    /@*/
    method getCode()    as character class GqlError
        return ::cCode
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Array - Paths array
    /@*/
    method getPaths()   as array class GqlError
        return ::aPaths
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cPath Character - Path segment
    @return Object - self
    /@*/
    method addPath(cPath as character) as object class GqlError
        aAdd(::aPaths, cPath)
        return self
    endmethod
endclass

endnamespace
