#include "tlpp-core.th"
#include "totvs.ch"

namespace custom.backoffice.graphql

/*/{Protheus.doc}
@type Object
@author GraphQL Engine Team
@since 3.0.0
@desc GqlQueryBuilder - turns a table name, a scalar field list and parsed
      GraphQL arguments into a paginated SQL query with FWExecStatement
      bind parameters. Every query unconditionally gets the filial and
      D_E_L_E_T_ = ' ' filters - the caller cannot override or omit them
      (this environment runs on PostgreSQL, whose MVCC needs no lock hint
      on reads, so %nolock% is not used here - see Global Constraints).
      Every value that reaches the SQL is a '?' placeholder paired with a
      bind parameter (FWExecStatement/TCGenQry2); field and table names are
      the only things concatenated into the SQL text, and they are always
      dictionary-derived/validated - never raw client values. build()
      returns {"sql": <text>, "params": [{"t","v"}, ...]} in placeholder
      order; the executor binds them before OpenAlias().
      ponytail: pagination uses ROW_NUMBER() OVER (ORDER BY <SIX order 1>)
      wrapped in a subquery - portable across the SQL Server/Oracle/
      PostgreSQL backends Protheus targets. Add cursor pagination if
      offset-based paging on huge tables becomes a measured bottleneck.
/@*/
class GqlQueryBuilder
    private data oConfig as object

    public method new(oConfig as object) as object
    public method build(cTable as character, cFilialField as character, aScalarFields as array, oArgs as json, cOrderKey as character, cExtraWhere as character, aExtraParams as array) as json
    method resolveLimit(oArgs as json) as numeric
    method resolveOffset(oArgs as json) as numeric
    method applyFilters(oArgs as json, aParams as array) as character
    method opToSql(cOp as character) as character
    method joinFields(aFields as array) as character
    method mkParam(cType as character, xValue as variant) as json
endclass

method new(oConfig as object) as object class GqlQueryBuilder
    ::oConfig := oConfig
    return self

/*/{Protheus.doc}
@type Method
@author GraphQL Engine Team
@since 3.0.0
@param cTable Character - table alias
@param cFilialField Character - the real branch field name for cTable
       (e.g. "A1_FILIAL" for "SA1"; see GqlDictionaryReader:getFilialField()
       - never the same as cTable + "_FILIAL", the field prefix and the
       table alias are not the same string)
@param aScalarFields Array - field names to select
@param oArgs JSON - parsed GraphQL arguments (limit, offset, filter)
@param cOrderKey Character - "+"-joined key field list (Protheus's own SIX
       chave format, e.g. "A1_FILIAL+A1_COD+A1_LOJA") - converted to a
       comma-separated ORDER BY list internally; never valid SQL on its own
@param cExtraWhere Character - additional, already-parameterized WHERE
       fragment, or "" (used by the executor to scope nested relationship
       queries to the parent row's key; it may contain '?' placeholders
       whose values are supplied via aExtraParams, in order)
@param aExtraParams Array - bind params ({"t","v"} JSON objects) matching
       the '?' placeholders in cExtraWhere, in order, or {} if none
@return JSON - {"sql": <ready-to-run text>, "params": [{"t","v"}, ...]} in
       placeholder order: filial (if any), then each filter value, then
       aExtraParams, then offset and offset+limit as numerics. The executor
       binds them and calls OpenAlias().
/@*/
method build(cTable as character, cFilialField as character, aScalarFields as array, oArgs as json, cOrderKey as character, cExtraWhere as character, aExtraParams as array) as json class GqlQueryBuilder
    local nLimit       := ::resolveLimit(oArgs) as numeric
    local nOffset      := ::resolveOffset(oArgs) as numeric
    local cWhere       := "D_E_L_E_T_ = ' '" as character
    local cSelect      := ::joinFields(aScalarFields) as character
    local cFilterWhere as character
    local cSql         as character
    local aParams      := {} as array
    local oOut         as json
    local nI           := 0 as numeric

    if !empty(cFilialField)
        cWhere += " AND " + cFilialField + " = ?"
        aAdd(aParams, ::mkParam("C", cFilAnt))
    endif

    cFilterWhere := ::applyFilters(oArgs, aParams)
    if !empty(cFilterWhere)
        cWhere += " AND " + cFilterWhere
    endif

    if !empty(cExtraWhere)
        cWhere += " AND " + cExtraWhere
    endif

    for nI := 1 to len(aExtraParams)
        aAdd(aParams, aExtraParams[nI])
    next nI

    // cOrderKey chega no formato de chave SIX próprio do Protheus
    // ("+"-unido, ex. "A1_FILIAL+A1_COD+A1_LOJA") - não é sintaxe SQL
    // válida por si só ("+" significa adição aritmética entre colunas
    // caracteres no PostgreSQL, não concatenação). Converte para uma
    // lista de colunas separadas por vírgula para o ORDER BY.
    cSql := "SELECT " + cSelect + " FROM (" + ;
             "SELECT " + cSelect + ", ROW_NUMBER() OVER (ORDER BY " + StrTran(cOrderKey, "+", ", ") + ") AS GQL_RN" + ;
             " FROM " + RetSqlName(cTable) + " WHERE " + cWhere + ;
             ") GQL_PAGE WHERE GQL_RN > ? AND GQL_RN <= ?"

    aAdd(aParams, ::mkParam("N", nOffset))
    aAdd(aParams, ::mkParam("N", nOffset + nLimit))

    oOut := JsonObject():New()
    oOut["sql"] := cSql
    oOut["params"] := aParams
    return oOut

method resolveLimit(oArgs as json) as numeric class GqlQueryBuilder
    local nLimit := ::oConfig:getDefaultPageSize() as numeric
    if oArgs["limit"] != nil
        nLimit := oArgs["limit"]["value"]
    endif
    if nLimit > ::oConfig:getMaxPageSize()
        nLimit := ::oConfig:getMaxPageSize()
    endif
    return nLimit

method resolveOffset(oArgs as json) as numeric class GqlQueryBuilder
    if oArgs["offset"] != nil
        return oArgs["offset"]["value"]
    endif
    return 0

method applyFilters(oArgs as json, aParams as array) as character class GqlQueryBuilder
    local oFilterArg := oArgs["filter"] as json
    local aFilters := {} as array
    local aClauses := {} as array
    local nI       := 0 as numeric
    local oFilter  as json
    local cOp      as character
    local cSqlOp   as character
    local cResult  := "" as character

    if oFilterArg == nil
        return ""
    endif
    aFilters := oFilterArg["value"]

    for nI := 1 to len(aFilters)
        oFilter := aFilters[nI]["value"]
        cOp     := oFilter["op"]["value"]
        cSqlOp  := ::opToSql(cOp)
        aAdd(aClauses, oFilter["field"]["value"] + " " + cSqlOp + " ?")
        aAdd(aParams, ::mkParam("C", cValToChar(oFilter["value"]["value"])))
    next nI

    for nI := 1 to len(aClauses)
        if nI > 1
            cResult += " AND "
        endif
        cResult += aClauses[nI]
    next nI

    return cResult

method opToSql(cOp as character) as character class GqlQueryBuilder
    if cOp == "eq"
        return "="
    elseif cOp == "gt"
        return ">"
    elseif cOp == "gte"
        return ">="
    elseif cOp == "lt"
        return "<"
    elseif cOp == "lte"
        return "<="
    endif
    return "=" // o GqlValidator já rejeita operadores não suportados antes de build() rodar

method joinFields(aFields as array) as character class GqlQueryBuilder
    local cResult := "" as character
    local nI      := 0 as numeric
    for nI := 1 to len(aFields)
        if nI > 1
            cResult += ", "
        endif
        cResult += aFields[nI]
    next nI
    return cResult

method mkParam(cType as character, xValue as variant) as json class GqlQueryBuilder
    local oP := JsonObject():New() as json
    oP["t"] := cType
    oP["v"] := xValue
    return oP