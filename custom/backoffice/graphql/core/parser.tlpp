#include "tlpp-core.th"
#include "totvs.ch"

namespace custom.backoffice.graphql

// --------------------------------------------------------------------------
// GqlParser - Lexer + Parser for GraphQL queries
// Implements a recursive-descent parser for the GraphQL query language.
// --------------------------------------------------------------------------
/*/{Protheus.doc}
@type Object
@author GraphQL Engine Team
@since 1.0.0
/@*/
class GqlParser
    private data cSource    as character
    private data nPos       as numeric
    private data nLen       as numeric
    private data aErrors    as array

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Object - self
    /@*/
    method new() as object class GqlParser
        ::aErrors := {}
        return self
    endmethod

    // -- Public API --

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cSource Character - GraphQL query string
    @return JSON - AST Document object or error JSON
    /@*/
    method parse(cSource as character) as json class GqlParser
        ::cSource   := cSource
        ::nPos      := 1
        ::nLen      := len(cSource)
        ::aErrors   := {}

        local oDoc := ::parseDocument()
        if len(::aErrors) > 0
            local oErr := JsonParse("{}")
            JsonSet(oErr, "errors", ::aErrors)
            return oErr
        endif
        return oDoc
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Array - List of parse error strings
    /@*/
    method getErrors() as array class GqlParser
        return ::aErrors
    endmethod

    // -- Lexer helpers --

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @desc Skip whitespace and comments, advancing nPos past them
    /@*/
    method skipWhitespace() class GqlParser
        local cCh
        while ::nPos <= ::nLen
            cCh := substr(::cSource, ::nPos, 1)
            if cCh == " " .or. cCh == _TAB .or. cCh == CHR(10) .or. cCh == CHR(13)
                ::nPos++
            elseif cCh == "#"
                ::skipComment()
            else
                exit
            endif
        enddo
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @desc Skip from '#' to end of line
    /@*/
    method skipComment() class GqlParser
        local cCh
        while ::nPos <= ::nLen
            cCh := substr(::cSource, ::nPos, 1)
            if cCh == CHR(10)
                ::nPos++
                exit
            endif
            ::nPos++
        enddo
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Current non-whitespace character, or empty string if at end
    /@*/
    method peek() as character class GqlParser
        ::skipWhitespace()
        if ::nPos > ::nLen
            return ""
        endif
        return substr(::cSource, ::nPos, 1)
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Current character and advance position by one
    /@*/
    method readChar() as character class GqlParser
        local cCh := ::peek()
        if cCh != ""
            ::nPos++
        endif
        return cCh
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @param cExpected Character - Expected character to consume
    @desc Consume the expected character or add a parse error
    /@*/
    method expect(cExpected as character) class GqlParser
        local cCh := ::readChar()
        if cCh != cExpected
            aAdd(::aErrors, "Expected '" + cExpected + "' but found '" + cCh + "'")
        endif
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Identifier string (letters, digits, underscore)
    /@*/
    method readName() as character class GqlParser
        local cName := ""
        local cCh
        local nStart := ::nPos

        while ::nPos <= ::nLen
            cCh := substr(::cSource, ::nPos, 1)
            if (cCh >= "a" .and. cCh <= "z") .or. (cCh >= "A" .and. cCh <= "Z") .or. (cCh >= "0" .and. cCh <= "9") .or. cCh == "_"
                cName += cCh
                ::nPos++
            else
                exit
            endif
        enddo

        if empty(cName)
            cCh := ::peek()
            aAdd(::aErrors, "Expected name but found '" + cCh + "'")
        endif
        return cName
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Quoted string with escape sequences resolved
    /@*/
    method readString() as character class GqlParser
        local cQuote := ::readChar()
        local cStr   := ""
        local cCh

        if cQuote != "\""
            aAdd(::aErrors, "Expected string starting with quote")
            return ""
        endif

        while ::nPos <= ::nLen
            cCh := substr(::cSource, ::nPos, 1)
            if cCh == "\""
                ::nPos++
                return cStr
            elseif cCh == "\\"
                ::nPos++
                cCh := substr(::cSource, ::nPos, 1)
                if cCh == "n"
                    cStr += CHR(10)
                elseif cCh == "t"
                    cStr += CHR(9)
                elseif cCh == "\""
                    cStr += "\""
                elseif cCh == "\\"
                    cStr += "\\"
                else
                    cStr += cCh
                endif
                ::nPos++
            else
                cStr += cCh
                ::nPos++
            endif
        enddo

        aAdd(::aErrors, "Unterminated string")
        return cStr
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Character - Numeric literal string (may include leading minus and decimal point)
    /@*/
    method readNumber() as character class GqlParser
        local cNum := ""
        local cCh

        if substr(::cSource, ::nPos, 1) == "-"
            cNum := "-"
            ::nPos++
        endif

        while ::nPos <= ::nLen
            cCh := substr(::cSource, ::nPos, 1)
            if (cCh >= "0" .and. cCh <= "9") .or. cCh == "."
                cNum += cCh
                ::nPos++
            else
                exit
            endif
        enddo

        if empty(cNum) .or. cNum == "-"
            aAdd(::aErrors, "Expected number")
        endif
        return cNum
    endmethod

    // -- Parser methods --

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return JSON - Document AST node
    /@*/
    method parseDocument() as json class GqlParser
        local aDefs  := {}
        local oDef

        while ::peek() != ""
            oDef := ::parseDefinition()
            if oDef != nil
                aAdd(aDefs, oDef)
            endif
        enddo

        local oDoc := JsonParse("{}")
        JsonSet(oDoc, "kind", "Document")
        JsonSet(oDoc, "definitions", aDefs)
        return oDoc
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return JSON - OperationDefinition or selection set AST node, or nil on error
    /@*/
    method parseDefinition() as json class GqlParser
        local cPeek := ::peek()

        if cPeek == "{"
            return ::parseSelectionSet()
        elseif cPeek == "query" .or. cPeek == "mutation" .or. cPeek == "subscription"
            return ::parseOperationDefinition()
        else
            aAdd(::aErrors, "Unexpected token: " + cPeek)
            ::nPos++
            return nil
        endif
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return JSON - OperationDefinition AST node
    /@*/
    method parseOperationDefinition() as json class GqlParser
        local cOpType := ::readName()
        local cName   := ""
        local aVars   := {}
        local oSS     := nil

        // Read optional operation name
        if ::peek() >= "a" .and. (::peek() <= "z" .or. ::peek() >= "A" .and. ::peek() <= "Z")
            cName := ::readName()
        endif

        // Read optional variable definitions
        if ::peek() == "("
            aVars := ::parseVariableDefinitions()
        endif

        // Selection set is mandatory
        oSS := ::parseSelectionSet()

        local oOp := JsonParse("{}")
        JsonSet(oOp, "kind", "OperationDefinition")
        JsonSet(oOp, "operation", cOpType)
        JsonSet(oOp, "name", cName)
        JsonSet(oOp, "variableDefinitions", aVars)
        JsonSet(oOp, "selectionSet", oSS)
        return oOp
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Array - Array of selection AST nodes
    /@*/
    method parseSelectionSet() as array class GqlParser
        local aSelections := {}
        local oSel

        ::expect("{")
        while ::peek() != "}" .and. ::peek() != ""
            oSel := ::parseSelection()
            if oSel != nil
                aAdd(aSelections, oSel)
            endif
        enddo
        ::expect("}")

        return aSelections
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return JSON - Field AST node
    /@*/
    method parseSelection() as json class GqlParser
        local cName1 := ::readName()
        local cAlias := cName1
        local cName2 := ""
        local oArgs  := JsonParse("{}")
        local oSS    := nil
        local oField := JsonParse("{}")

        if ::peek() == ":"
            ::readChar()
            cName2 := ::readName()
            cAlias  := cName1
            cName1  := cName2
        endif

        if ::peek() == "("
            oArgs := ::parseArgumentCollection()
        endif

        if ::peek() == "{"
            oSS := ::parseSelectionSet()
        endif

        JsonSet(oField, "kind", "Field")
        JsonSet(oField, "name", cName1)
        if cAlias != cName1
            JsonSet(oField, "alias", cAlias)
        endif
        JsonSet(oField, "arguments", oArgs)
        if oSS != nil
            JsonSet(oField, "selectionSet", oSS)
        endif

        return oField
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return JSON - Argument collection as JSON object
    /@*/
    method parseArgumentCollection() as json class GqlParser
        local oArgs  := JsonParse("{}")
        local cName

        ::expect("(")
        while ::peek() != ")" .and. ::peek() != ""
            cName := ::readName()
            ::expect(":")
            local oVal := ::parseValue()
            JsonSet(oArgs, cName, oVal)
        enddo
        ::expect(")")

        return oArgs
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return JSON - Parsed value AST node
    /@*/
    method parseValue() as json class GqlParser
        local cCh := ::peek()

        if cCh == "$"
            ::readChar()
            local cVar := ::readName()
            local oVar := JsonParse("{}")
            JsonSet(oVar, "kind", "Variable")
            JsonSet(oVar, "name", cVar)
            return oVar
        elseif cCh == "\""
            local cStr := ::readString()
            local oVal := JsonParse("{}")
            JsonSet(oVal, "kind", "StringValue")
            JsonSet(oVal, "value", cStr)
            return oVal
        elseif cCh == "{"
            return ::parseObjectValue()
        elseif cCh == "["
            local aArr := ::parseListOfValues()
            local oVal := JsonParse("{}")
            JsonSet(oVal, "kind", "ListValue")
            JsonSet(oVal, "value", aArr)
            return oVal
        elseif cCh == "true"
            ::nPos += 4
            local oVal := JsonParse("{}")
            JsonSet(oVal, "kind", "BooleanValue")
            JsonSet(oVal, "value", .T.)
            return oVal
        elseif cCh == "false"
            ::nPos += 5
            local oVal := JsonParse("{}")
            JsonSet(oVal, "kind", "BooleanValue")
            JsonSet(oVal, "value", .F.)
            return oVal
        elseif cCh == "null"
            ::nPos += 4
            local oVal := JsonParse("{}")
            JsonSet(oVal, "kind", "NullValue")
            return oVal
        elseif (cCh >= "a" .and. cCh <= "z") .or. (cCh >= "A" .and. cCh <= "Z")
            local cEnum := ::readName()
            local oVal := JsonParse("{}")
            JsonSet(oVal, "kind", "EnumValue")
            JsonSet(oVal, "value", cEnum)
            return oVal
        elseif (cCh >= "0" .and. cCh <= "9") .or. cCh == "-"
            local cNum := ::readNumber()
            local oVal := JsonParse("{}")
            if dotpos(".", cNum) > 0
                JsonSet(oVal, "kind", "FloatValue")
                JsonSet(oVal, "value", cValToNumber(cNum))
            else
                JsonSet(oVal, "kind", "IntValue")
                JsonSet(oVal, "value", cValToNumber(cNum))
            endif
            return oVal
        else
            aAdd(::aErrors, "Unexpected value token: " + cCh)
            ::nPos++
            local oFail := JsonParse("{}")
            JsonSet(oFail, "kind", "NullValue")
            return oFail
        endif
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return JSON - Object value AST node
    /@*/
    method parseObjectValue() as json class GqlParser
        local oObj   := JsonParse("{}")
        local cName

        ::expect("{")
        while ::peek() != "}" .and. ::peek() != ""
            cName := ::readName()
            ::expect(":")
            local oVal := ::parseValue()
            JsonSet(oObj, cName, oVal)
        enddo
        ::expect("}")

        return oObj
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Array - Array of value AST nodes
    /@*/
    method parseListOfValues() as array class GqlParser
        local aVals := {}
        local oVal

        ::expect("[")
        while ::peek() != "]" .and. ::peek() != ""
            oVal := ::parseValue()
            aAdd(aVals, oVal)
        enddo
        ::expect("]")

        return aVals
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return Array - Array of VariableDefinition AST nodes
    /@*/
    method parseVariableDefinitions() as array class GqlParser
        local aVars  := {}
        local cName
        local oType

        ::expect("(")
        while ::peek() != ")" .and. ::peek() != ""
            ::expect("$")
            cName := ::readName()
            ::expect(":")
            oType := ::parseTypeReference()
            local oVar := JsonParse("{}")
            JsonSet(oVar, "kind", "VariableDefinition")
            JsonSet(oVar, "name", cName)
            JsonSet(oVar, "type", oType)
            aAdd(aVars, oVar)
        enddo
        ::expect(")")

        return aVars
    endmethod

    /*/{Protheus.doc}
    @type Method
    @author GraphQL Engine Team
    @since 1.0.0
    @return JSON - Type reference AST node (NamedType, ListType, or NonNullType)
    /@*/
    method parseTypeReference() as json class GqlParser
        local cPeek := ::peek()
        local oType := JsonParse("{}")

        if cPeek == "["
            ::readChar()
            local oElemType := ::parseTypeReference()
            ::expect("]")
            JsonSet(oType, "kind", "ListType")
            JsonSet(oType, "ofType", oElemType)
        elseif cPeek == "!"
            ::readChar()
            local oInner := ::parseTypeReference()
            JsonSet(oType, "kind", "NonNullType")
            JsonSet(oType, "ofType", oInner)
        else
            local cName := ::readName()
            JsonSet(oType, "kind", "NamedType")
            JsonSet(oType, "name", cName)
        endif

        return oType
    endmethod
endclass

endnamespace
