#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

/*/{Protheus.doc}
GQLSERVICE
Ponto de entrada REST GraphQL dinâmico sobre o dicionário de dados do Protheus.
GET /rest/graphql              -> nomes dos tipos do schema (lista de bloqueio aplicada)
GET /rest/graphql?type=<TABLE> -> detalhe completo do tipo de uma tabela
GET /rest/graphql?sdk=<TABLE>  -> classe TLPP tipada gerada para a tabela
GET /rest/graphql?query=<...>  -> execução completa da consulta
@type User Function
@author GraphQL Engine Team
@since 3.0.0
@return Logico - .T.
/*/
@Get("/graphql")
User Function GQLSERVICE() as logical
    local oConfig    := custom.backoffice.graphql.GqlConfig():new()             as object
    local oAuthCtx   := custom.backoffice.graphql.GqlAuthContext():new()        as object
    local oAccess    := custom.backoffice.graphql.GqlAccessControl():new(oConfig, oAuthCtx) as object
    local oFieldHooks := custom.backoffice.graphql.GqlFieldHooks():new(oConfig)      as object
    local oDict      := custom.backoffice.graphql.GqlDictionaryReader():new(oAccess) as object
    local oSchema    := custom.backoffice.graphql.GqlSchemaProvider():new(oDict, oConfig) as object
    local jParams    as json
    local cQuery     := "" as character
    local cTypeName  := "" as character
    local cSdkTable  := "" as character
    local cSdkSrc    := "" as character
    local oResult    as json
    local oExecutor  as object
    local oPeekParser as object
    local oPeekDoc    as json
    local oMutSchema  as object
    local oMutValidator as object
    local oMutWriter  as object
    local oMutExecutor as object
    local oSdkGen      as object

    jParams   := oRest:getQueryRequest()
    cQuery    := jParams:GetJsonText("query")
    cTypeName := jParams:GetJsonText("type")
    cSdkTable := jParams:GetJsonText("sdk")
    if cQuery == "null"
        cQuery := ""
    endif
    if cTypeName == "null"
        cTypeName := ""
    endif
    if cSdkTable == "null"
        cSdkTable := ""
    endif

    if !empty(cQuery)
        oPeekParser := custom.backoffice.graphql.GqlParser():new(cQuery)
        oPeekDoc := oPeekParser:parse()
        if oPeekDoc == nil
            oResult := custom.backoffice.graphql.GqlErrors():fromArray(oPeekParser:getErrors())
        elseif len(oPeekDoc["definitions"]) > 0 .and. oPeekDoc["definitions"][1]["operation"] == "mutation"
            oMutSchema    := custom.backoffice.graphql.GqlMutationSchema():new(oSchema, oConfig)
            oMutValidator := custom.backoffice.graphql.GqlInputValidator():new(oDict)
            oMutWriter    := custom.backoffice.graphql.GqlWorkareaWriter():new(oDict, oFieldHooks)
            oExecutor     := custom.backoffice.graphql.GqlExecutor():new(oSchema, oDict, custom.backoffice.graphql.GqlQueryBuilder():new(oConfig), oAccess, oFieldHooks)
            oMutExecutor  := custom.backoffice.graphql.GqlMutationExecutor():new(oMutSchema, oDict, oMutValidator, oMutWriter, oExecutor, oAccess)
            oResult := oMutExecutor:execute(cQuery)
        else
            oExecutor := custom.backoffice.graphql.GqlExecutor():new(oSchema, oDict, custom.backoffice.graphql.GqlQueryBuilder():new(oConfig), oAccess, oFieldHooks)
            oResult := oExecutor:execute(cQuery)
        endif
    elseif !empty(cSdkTable)
        if oSchema:getType(upper(alltrim(cSdkTable))) == nil
            oResult := custom.backoffice.graphql.GqlErrors():single("Unknown or restricted type: " + cSdkTable)
        else
            oSdkGen := custom.backoffice.graphql.GqlSdkGenerator():new(oDict)
            cSdkSrc := oSdkGen:generate(cSdkTable)
            oResult := JsonObject():New()
            oResult["data"] := JsonObject():New()
            oResult["data"]["sdk"] := cSdkSrc
        endif
    elseif !empty(cTypeName)
        oResult := custom.backoffice.graphql.GqlIntrospection():typeDetail(oSchema, cTypeName)
    else
        oResult := custom.backoffice.graphql.GqlIntrospection():schemaNames(oSchema)
    endif

    oRest:setStatusResponse(200, oResult:toJson())

Return .T.
