#include "tlpp-core.th"
#include "totvs.ch"
#include "types.tlpp"
#include "schema.tlpp"

namespace custom.backoffice.graphql

// --------------------------------------------------------------------------
// initSB1Schema — inicializa o schema SB1 (produtos) no GqlSchema
// --------------------------------------------------------------------------
/*/{Protheus.doc}
@author GraphQL Engine Team
@since 1.0.0
@param oSchema Object - instância de GqlSchema
@return Object - self para encadeamento
@type Function
/*@*/
function initSB1Schema(oSchema as object) as object
    FWLogMsg("initSB1Schema: starting SB1 schema registration", .T.)
    buildProductType(oSchema)
    buildProductQueryFields(oSchema)
    FWLogMsg("initSB1Schema: SB1 schema registered successfully", .T.)
    return oSchema
endfunction

endnamespace
